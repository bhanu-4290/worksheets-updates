generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  MANAGER
  TEAM_LEAD
  EXECUTIVE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REVISION_REQUESTED
}

enum ReviewDecision {
  APPROVED
  REVISION_REQUESTED
}

enum EscalationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED_TO_ADMIN
}

enum EscalationUrgency {
  NORMAL
  HIGH
  CRITICAL
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  managerId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager      User?         @relation("DepartmentManager", fields: [managerId], references: [id])
  users        User[]        @relation("UserDepartment")
  teams        Team[]
  projects     Project[]
  tasks        Task[]
  escalations  BlockerEscalation[]
  announcements Announcement[]

  @@map("departments")
}

model Team {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  departmentId String
  teamLeadId   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teamLead     User?            @relation("TeamLeadUser", fields: [teamLeadId], references: [id])
  memberships  TeamMembership[]
  users        User[]           @relation("UserTeamLeadTeam")
  announcements Announcement[]

  @@map("teams")
}

model TeamMembership {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_memberships")
}

model User {
  id           String    @id @default(uuid())
  employeeId   String    @unique
  email        String    @unique
  passwordHash String
  fullName     String
  jobTitle     String
  role         Role      @default(EXECUTIVE)
  departmentId String?
  managerId    String?
  teamLeadId   String?
  joiningDate  DateTime  @default(now())
  dateOfBirth  DateTime?
  isActive     Boolean   @default(true)
  profileImage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department         Department?          @relation("UserDepartment", fields: [departmentId], references: [id])
  manager            User?                @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates       User[]               @relation("ManagerSubordinates")
  teamLead           User?                @relation("TeamLeadSubordinates", fields: [teamLeadId], references: [id])
  leadMembers        User[]               @relation("TeamLeadSubordinates")
  managedDepartments Department[]         @relation("DepartmentManager")
  ledTeams           Team[]               @relation("TeamLeadUser")
  assignedTeams      Team[]               @relation("UserTeamLeadTeam")
  teamMemberships    TeamMembership[]

  createdTasks       Task[]               @relation("TaskCreator")
  assignedLeadTasks  Task[]               @relation("TaskTeamLead")
  taskAssignments    TaskAssignment[]
  taskComments       TaskComment[]
  taskHistories      TaskHistory[]

  dailyReports         DailyReport[]        @relation("UserReports")
  reviewsGiven         ReportReview[]       @relation("Reviewer")
  escalatedBlockers    BlockerEscalation[]  @relation("EscalatedByUser")
  ownedEscalations     BlockerEscalation[]  @relation("EscalationOwner")
  notifications        Notification[]       @relation("NotificationRecipient")
  sentNotifications    Notification[]       @relation("NotificationSender")
  sentChatMessages     ChatMessage[]        @relation("SentChatMessages")
  receivedChatMessages ChatMessage[]        @relation("ReceivedChatMessages")
  announcements        Announcement[]       @relation("UserAnnouncements")
  auditLogs            AuditLog[]
  resetTokens          PasswordResetToken[]

  @@map("users")
}

model Project {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique
  description  String?
  departmentId String
  status       String    @default("ACTIVE")
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tasks      Task[]

  @@map("projects")
}

model Task {
  id                 String       @id @default(uuid())
  taskCode           String       @unique
  title              String
  description        String
  projectId          String
  departmentId       String
  assignedTeamLeadId String?
  createdById        String
  priority           TaskPriority @default(MEDIUM)
  status             TaskStatus   @default(TO_DO)
  startDate          DateTime?
  dueDate            DateTime?
  estimatedHours     Float?
  progressPercentage Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department       Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teamLead         User?            @relation("TaskTeamLead", fields: [assignedTeamLeadId], references: [id])
  createdBy        User             @relation("TaskCreator", fields: [createdById], references: [id])
  assignments      TaskAssignment[]
  comments         TaskComment[]
  histories        TaskHistory[]
  dailyWorkEntries DailyWorkEntry[]

  @@map("tasks")
}

model TaskAssignment {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_assignments")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

model TaskHistory {
  id            String   @id @default(uuid())
  taskId        String
  userId        String
  action        String
  previousValue String?
  newValue      String?
  details       String?
  createdAt     DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_histories")
}

model DailyReport {
  id            String       @id @default(uuid())
  userId        String
  reportingDate DateTime     @db.Date
  status        ReportStatus @default(DRAFT)
  submittedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user             User                    @relation("UserReports", fields: [userId], references: [id], onDelete: Cascade)
  entries          DailyWorkEntry[]
  reviews          ReportReview[]
  revisionHistory  ReportRevisionHistory[]
  escalations      BlockerEscalation[]

  @@unique([userId, reportingDate], name: "user_date_unique")
  @@map("daily_reports")
}

model DailyWorkEntry {
  id                 String   @id @default(uuid())
  dailyReportId      String
  taskId             String?
  activityTitle      String
  description        String
  startTime          String?
  endTime            String?
  hoursSpent         Float?
  progressPercentage Int      @default(0)
  status             String   @default("IN_PROGRESS")
  deliverables       String?
  blockers           String?
  supportRequired    String?
  nextDayPlan        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dailyReport DailyReport         @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  task        Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  escalations BlockerEscalation[]

  @@map("daily_work_entries")
}

model ReportReview {
  id            String         @id @default(uuid())
  dailyReportId String
  reviewerId    String
  reviewStatus  ReviewDecision
  comments      String
  createdAt     DateTime       @default(now())

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@map("report_reviews")
}

model ReportRevisionHistory {
  id             String   @id @default(uuid())
  dailyReportId  String
  revisionNumber Int      @default(1)
  snapshotJson   String
  reason         String?
  createdAt      DateTime @default(now())

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  @@map("report_revision_histories")
}

model BlockerEscalation {
  id              String            @id @default(uuid())
  workEntryId     String?
  dailyReportId   String?
  departmentId    String
  escalatedById   String
  assignedOwnerId String?
  status          EscalationStatus  @default(OPEN)
  urgency         EscalationUrgency @default(NORMAL)
  title           String
  description     String
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  workEntry     DailyWorkEntry? @relation(fields: [workEntryId], references: [id], onDelete: SetNull)
  dailyReport   DailyReport?    @relation(fields: [dailyReportId], references: [id], onDelete: SetNull)
  department    Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  escalatedBy   User            @relation("EscalatedByUser", fields: [escalatedById], references: [id], onDelete: Cascade)
  assignedOwner User?           @relation("EscalationOwner", fields: [assignedOwnerId], references: [id])

  @@map("blocker_escalations")
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  senderId    String?
  eventType   String
  title       String
  message     String
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User? @relation("NotificationSender", fields: [senderId], references: [id])

  @@map("notifications")
}

model CompanySetting {
  id                     String   @id @default(uuid())
  companyName            String   @default("WorkTrack Enterprise")
  timezone               String   @default("UTC")
  workDays               String   @default("Monday,Tuesday,Wednesday,Thursday,Friday")
  submissionDeadlineTime String   @default("19:00")
  gracePeriodHours       Int      @default(2)
  allowMidnightEntries   Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("company_settings")
}

model Holiday {
  id          String   @id @default(uuid())
  name        String
  date        DateTime @db.Date
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([name, date])
  @@map("holidays")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  detailsJson  String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedChatMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
  @@map("chat_messages")
}

model Announcement {
  id           String   @id @default(uuid())
  title        String
  content      String
  priority     String   @default("NORMAL")
  targetScope  String   @default("ALL")
  departmentId String?
  teamId       String?
  isPinned     Boolean  @default(false)
  authorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author     User        @relation("UserAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  team       Team?       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

